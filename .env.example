# ============================================================
# Variables de Entorno para LeyIA Chile (Frontend Vite & Vercel)
# ============================================================
# IMPORTANTE: Las variables sin prefijo VITE_ son SOLO para el backend.
# Las variables con prefijo VITE_ se incluyen en el bundle del navegador.
# NUNCA pongas API Keys privadas con prefijo VITE_.

# 1. Google Gemini API (SOLO BACKEND — sin prefijo VITE_)
GEMINI_API_KEY="tu_clave_api_gemini_aqui"

# 2. Supabase Backend (La Anon Key es pública por diseño, protegida por RLS)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Flow.cl Pagos (SOLO BACKEND — sin prefijo VITE_)
FLOW_API_KEY="tu_flow_api_key_aqui"
FLOW_SECRET_KEY="tu_flow_secret_key_aqui"
FLOW_ENVIRONMENT="production"

# 4. Supabase Service Role Key (SOLO BACKEND — para validación de pagos)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu_service_role_key_aqui"
